rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return userDoc().data.role;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userRole() in ['admin', 'super_admin'];
    }

    function isSuperAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userRole() == 'super_admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /adminInvites/{inviteId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && resource.data.status == 'pending');
      allow create, update, delete: if isSuperAdmin();
    }

    match /pages/{pageId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if resource.data.isPublic == true || isAdmin()
        || (isSignedIn() && request.auth.uid in resource.data.get('attendees', []));
      allow create, update, delete: if isAdmin();
    }

    match /eventRegistrations/{registrationId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /membershipPlans/{planId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /testimonials/{testimonialId} {
      allow read: if resource.data.isPublished == true || isAdmin()
        || (isSignedIn() && resource.data.get('authorId', '') == request.auth.uid);
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /contactSubmissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /formSubmissions/{submissionId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /customForms/{formId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /chatLogs/{logId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /eventTags/{tagId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /eventDiscountCodes/{codeId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /faqs/{faqId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /chatLeads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
